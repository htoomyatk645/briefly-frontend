{
  "name": "briefly",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "web",
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:mobile": "npm run start --workspace=mobile",
    "build:web": "npm run build --workspace=web",
    "preview:web": "npm run build --workspace=web && npm run preview --workspace=web -- --host 0.0.0.0 --port 5173"
  }
}
